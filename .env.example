# --- Asisten triase (LLM) ---------------------------------------------------
# Tanpa kredensial apa pun aplikasi tetap berjalan penuh; panel triase
# menampilkan protokol FAST statis alih-alih ringkasan yang disusun model.
#
# Pilih penyedia secara eksplisit, atau kosongkan agar dipilih otomatis dari
# kunci yang tersedia (OpenRouter lebih dulu).
# TRIAGE_PROVIDER=openrouter   # openrouter | anthropic

# Opsi A - OpenRouter (sesuai draft)
OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL=https://domain-anda.example   # opsional, untuk dasbor OpenRouter

# Opsi B - Anthropic API resmi (mendukung adaptive thinking + effort)
ANTHROPIC_API_KEY=

# Override model. Default: "anthropic/claude-sonnet-4.5" (OpenRouter)
# atau "claude-sonnet-4-5" (Anthropic).
#
# Catatan: parameter adaptive thinking dan effort HANYA dikirim untuk model
# generasi 4.6 ke atas. Sonnet 4.5 menolak keduanya (HTTP 400), jadi keduanya
# otomatis dihilangkan. Model yang tidak dikenali juga mengambil cabang aman ini.
# TRIAGE_MODEL=

# --- Inference server (opsional) --------------------------------------------
# Bila diisi, ekstraksi metrik didelegasikan ke layanan GPU (FastAPI + PyTorch)
# lewat POST {URL}/extract. Bila kosong atau gagal dihubungi, ekstraksi CHROM
# lokal di Node yang dipakai. Lihat lib/inference.ts untuk kontraknya.
INFERENCE_SERVER_URL=
INFERENCE_SERVER_TOKEN=

# --- Ambang batas medis -----------------------------------------------------
# Semua nilai punya default di lib/thresholds.ts. Isi hanya bila ingin menyetel.
# STROKE_WINDOW_SECONDS=5
# STROKE_HR_SPIKE_PCT=30
# STROKE_HR_MIN=40
# STROKE_HR_MAX=130
# STROKE_ASYMMETRY_WARN=25
# STROKE_ASYMMETRY_CRITICAL=40
# STROKE_MIN_SNR_DB=0
