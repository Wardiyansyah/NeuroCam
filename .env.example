# --- Asisten triase (LLM) via OpenRouter -------------------------------------
# Tanpa kunci ini aplikasi tetap berjalan penuh; panel triase menampilkan
# protokol FAST statis alih-alih ringkasan yang disusun model.
OPENROUTER_API_KEY=

# Opsional, hanya untuk atribusi di dasbor OpenRouter.
# OPENROUTER_SITE_URL=https://domain-anda.example

# Override model. Default: anthropic/claude-sonnet-4.5
# Awalan "anthropic/" adalah cara OpenRouter memberi namespace vendor pada
# nama model - bukan berarti API Anthropic yang dipanggil.
# TRIAGE_MODEL=

# --- Inference server (opsional) --------------------------------------------
# Bila diisi, ekstraksi metrik didelegasikan ke layanan GPU (FastAPI + PyTorch)
# lewat POST {URL}/extract. Bila kosong atau gagal dihubungi, ekstraksi CHROM
# lokal di Node yang dipakai. Lihat lib/inference.ts untuk kontraknya.
INFERENCE_SERVER_URL=
INFERENCE_SERVER_TOKEN=

# --- Ambang batas medis -----------------------------------------------------
# Semua nilai punya default di lib/thresholds.ts. Isi hanya bila ingin menyetel.
# STROKE_WINDOW_SECONDS=5
# STROKE_HR_SPIKE_PCT=30
# STROKE_HR_MIN=40
# STROKE_HR_MAX=130
# STROKE_ASYMMETRY_WARN=25
# STROKE_ASYMMETRY_CRITICAL=40
# STROKE_MIN_SNR_DB=0
